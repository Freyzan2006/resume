{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "basics": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "description": "Должность или короткий заголовок",
          "type": "string",
          "minLength": 1
        },
        "image": {
          "description": "URL фотографии",
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "description": "Личный сайт",
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "description": "О себе, markdown",
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "minLength": 1
            },
            "postalCode": {
              "type": "string",
              "minLength": 1
            },
            "city": {
              "type": "string",
              "minLength": 1
            },
            "countryCode": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "profiles": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "network": {
                "type": "string",
                "minLength": 1,
                "description": "GitHub, Telegram, LinkedIn…"
              },
              "username": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "network"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "work": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Компания"
          },
          "position": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "description": "Чем занимается компания",
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "startDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
              },
              {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              }
            ]
          },
          "endDate": {
            "description": "Пусто — по настоящее время",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
              },
              {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              }
            ]
          },
          "summary": {
            "description": "Описание работы, markdown",
            "type": "string",
            "minLength": 1
          },
          "highlights": {
            "description": "Достижения, по одному на пункт",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "keywords": {
            "default": [],
            "description": "Стек (расширение JSON Resume)",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "position"
        ],
        "additionalProperties": false
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "keywords": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "startDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
              },
              {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              }
            ]
          },
          "endDate": {
            "description": "Пусто — по настоящее время",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
              },
              {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              }
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "roles": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "area": {
            "description": "Специальность",
            "type": "string",
            "minLength": 1
          },
          "studyType": {
            "description": "Степень: бакалавр, магистр…",
            "type": "string",
            "minLength": 1
          },
          "startDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
              },
              {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              }
            ]
          },
          "endDate": {
            "description": "Пусто — по настоящее время",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
              },
              {
                "type": "integer",
                "minimum": 1000,
                "maximum": 9999
              }
            ]
          },
          "score": {
            "type": "string",
            "minLength": 1
          },
          "courses": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "institution"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "languages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "fluency": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "language"
        ],
        "additionalProperties": false
      }
    },
    "volunteer": {
      "description": "Раздел JSON Resume, который сайт пока не показывает",
      "type": "array",
      "items": {}
    },
    "awards": {
      "description": "Раздел JSON Resume, который сайт пока не показывает",
      "type": "array",
      "items": {}
    },
    "certificates": {
      "description": "Раздел JSON Resume, который сайт пока не показывает",
      "type": "array",
      "items": {}
    },
    "publications": {
      "description": "Раздел JSON Resume, который сайт пока не показывает",
      "type": "array",
      "items": {}
    },
    "interests": {
      "description": "Раздел JSON Resume, который сайт пока не показывает",
      "type": "array",
      "items": {}
    },
    "references": {
      "description": "Раздел JSON Resume, который сайт пока не показывает",
      "type": "array",
      "items": {}
    },
    "meta": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "basics"
  ],
  "additionalProperties": false
}
