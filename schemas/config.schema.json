{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "profile": {
      "description": "Какое резюме собирать: папка в assets/. Можно не указывать, если папка одна",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "lang": {
      "default": "ru",
      "description": "Основной язык: его версия открывается по умолчанию. Для ru и en подписи встроены",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
    },
    "sections": {
      "default": [
        "summary",
        "work",
        "projects",
        "skills",
        "education",
        "certificates",
        "languages"
      ],
      "description": "Какие разделы показывать и в каком порядке",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "summary",
          "work",
          "projects",
          "skills",
          "education",
          "certificates",
          "languages"
        ]
      }
    },
    "formats": {
      "default": [
        "pdf"
      ],
      "description": "В каких форматах резюме можно скачать с сайта",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pdf",
          "json"
        ]
      }
    },
    "labels": {
      "default": {},
      "description": "Свои подписи вместо встроенных, по языкам: { ru: { work: Карьера } }",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "enum": [
            "summary",
            "work",
            "projects",
            "skills",
            "education",
            "certificates",
            "languages",
            "present",
            "download"
          ]
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
