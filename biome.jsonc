{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // generated by `bun run schema`, compared byte for byte in tests
    "includes": ["**", "!schemas"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":URL:",
                ":NODE:",
                ":PACKAGE:",
                "virtual:*",
                "!@core/**",
                "!@web/**",
                "!@build/**",
                "!@tests/**"
              ],
              ":BLANK_LINE:",
              ["@core/**", "@web/**", "@build/**", "@tests/**"],
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "linter": {
    "domains": { "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "fix": "safe",
          "options": { "functions": ["cn", "cva"] }
        }
      }
    }
  },
  // Layer boundaries, see README → «Архитектура»
  "overrides": [
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**/build/**", "../**/web/**"],
                    "message": "core не зависит от других слоёв"
                  },
                  {
                    "group": ["@core/**", "@build/**", "@web/**", "@tests/**"],
                    "message": "core исполняет node (через build) — только относительные импорты"
                  },
                  {
                    "group": [
                      "node:*",
                      "node:*/**",
                      "react",
                      "react-dom",
                      "@reatom/*"
                    ],
                    "message": "core — чистый TypeScript: без Node, React и состояния"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/build/**", "vite.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**/web/**"],
                    "message": "build не зависит от web"
                  },
                  {
                    "group": ["@core/**", "@build/**", "@web/**", "@tests/**"],
                    "message": "build исполняет node — только относительные импорты"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "cn": "импортируйте cn из \"@web/lib/utils\" — он знает роли текста"
                },
                "patterns": [
                  {
                    "group": ["@build/**", "../**/build/**", "@tests/**"],
                    "message": "web не зависит от build и тестов"
                  },
                  {
                    "group": [
                      "node:*",
                      "node:*/**",
                      "zod",
                      "yaml",
                      "unified",
                      "remark-*",
                      "rehype-*"
                    ],
                    "message": "зависимости времени сборки не должны попадать в браузер"
                  },
                  {
                    "group": [
                      "@core/resume-schema",
                      "@core/config-schema",
                      "@core/markdown",
                      "@core/labels",
                      "@core/site"
                    ],
                    "message": "эти модули core тянут zod и unified; типы берите из \"@core/types\""
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
