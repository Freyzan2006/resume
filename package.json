{
  "name": "resume",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node src/build/cli/export.ts",
    "build:site": "tsc -b && vite build",
    "preview": "vite preview",
    "export": "node src/build/cli/export.ts",
    "schema": "node src/build/cli/schema.ts",
    "check": "biome check --write",
    "lint": "biome lint",
    "format": "biome format --write",
    "typecheck": "tsc -b",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "biome ci && tsc -b && knip && vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@reatom/core": "^1001.3.0",
    "@reatom/react": "^1001.0.1",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "playwright": "^1.64.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "~6.0.2",
    "unified": "^11.0.5",
    "vite": "^8",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
